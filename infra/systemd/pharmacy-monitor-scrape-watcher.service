[Unit]
Description=Pharmacy Monitor — server-side scrape queue watcher (UI «Запустить scrape»)
Documentation=https://github.com/rashadrahimov/pharmacy-monitor
After=network.target postgresql.service pharmacy-monitor-api.service
Wants=postgresql.service

[Service]
Type=oneshot
User=pm
Group=pm
WorkingDirectory=/opt/pharmacy-monitor
EnvironmentFile=/etc/pharmacy-monitor/env
ExecStart=/bin/bash /opt/pharmacy-monitor/infra/server/watch-scrape-queue.sh
# Синхронный прогон может быть долгим (all-sites включает pharmonline ~7ч). По
# таймауту systemd убьёт весь cgroup (вкл. дочерний scrape) → запрос потом
# подберёт reap. Держим запас под полный прогон.
TimeoutStartSec=36000

# Security (зеркало pharmacy-monitor-scrape@.service)
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/pharmacy-monitor/data /opt/pharmacy-monitor/logs /opt/pharmacy-monitor/reports
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
