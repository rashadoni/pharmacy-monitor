[Unit]
Description=Pharmacy Monitor — scrape %i (parameterized: pharmonline / aptekonline / aloe)
After=network.target postgresql.service
Requires=postgresql.service

[Service]
Type=oneshot
User=pm
Group=pm
WorkingDirectory=/opt/pharmacy-monitor
EnvironmentFile=/etc/pharmacy-monitor/env
# Ритм держит не таймер, а сам `run` (src/cadence.py): запуск, заставший сайт
# уже собранным в текущем окне ритма (второй ночной будильник после удачного
# первого), выходит с кодом 0 без сбора. Эту строку читает
# tests/test_cadence_guard.py — меняешь её, гони тест.
ExecStart=/opt/pharmacy-monitor/.venv/bin/pharmacy-monitor run --site %i
# 10h max for full mega-scrape (pharmonline DDP can run ~7h)
TimeoutStartSec=36000

# Security
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/pharmacy-monitor/data /opt/pharmacy-monitor/logs /opt/pharmacy-monitor/reports
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
