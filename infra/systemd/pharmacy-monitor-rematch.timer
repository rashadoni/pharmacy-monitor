[Unit]
Description=Incremental rematch — Tuesdays and Fridays 04:30 host time

[Timer]
# Время хоста (Europe/Berlin), как у остальных таймеров сбора. Не понедельник:
# в понедельник идут недельные сборы всех трёх сайтов, и команда, которая при
# активном сборе выходит с «skipped», как страховка не работала бы.
# 04:30 — после ночных будильников сбора и до первого дневного тика (05:00).
# Два дня, потому что пропуск при занятом замке никто не повторяет, а неделя,
# когда сборы понедельника упали и повторяются по ночам, — как раз тот случай,
# ради которого юнит существует. Команда повторяема: второй прогон ничего не
# меняет.
OnCalendar=Tue,Fri *-*-* 04:30:00
Persistent=true

[Install]
WantedBy=timers.target
