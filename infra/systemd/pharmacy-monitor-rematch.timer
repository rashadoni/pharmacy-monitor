[Unit]
Description=Incremental rematch — Tuesdays and Fridays 04:30 host time

[Timer]
# Время хоста (Europe/Berlin), как у остальных таймеров сбора. 04:30 — после
# ночных будильников сбора (01:00 и повтор 03:15) и до первого дневного тика
# (05:00). Команда при активном сборе выходит с «skipped», и этот пропуск никто
# не повторяет — поэтому дня два. Вторник и пятница выбраны при недельном ритме
# (в понедельник шли сборы всех трёх сайтов); с 2026-10-13 сборы идут каждую
# ночь, и этап сопоставления исполняет каждый удачный из них — юнит остаётся
# страховкой на ночи, когда сборы упали. Команда повторяема: второй прогон
# ничего не меняет.
OnCalendar=Tue,Fri *-*-* 04:30:00
Persistent=true

[Install]
WantedBy=timers.target
