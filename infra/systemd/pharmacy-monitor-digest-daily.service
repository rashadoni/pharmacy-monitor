[Unit]
Description=Pharmacy Monitor — morning price letter (daily digest)
After=network.target postgresql.service

[Service]
Type=oneshot
User=pm
Group=pm
WorkingDirectory=/opt/pharmacy-monitor
EnvironmentFile=/etc/pharmacy-monitor/env
# Утреннее письмо: разница цен между сайтом клиента и конкурентами на сейчас
# (числа и Excel со страницы сравнения во вложении) и события за сутки.
# Получатели — tenant_users с daily_digest=True. --locale — язык вложения,
# текст письма русский.
#
# Не путать с pharmacy-monitor-digest@daily.timer: тот зовёт прежнюю команду
# `digest` (топ событий за сутки на EMAIL_TO) и на сервере выключен с июня
# 2026. Включить оба — два письма в одно и то же время.
ExecStart=/opt/pharmacy-monitor/.venv/bin/pharmacy-monitor notify digest daily --locale az
# У oneshot без предела зависшая команда держала бы юнит вечно, и следующее
# утро таймер его бы не запустил. Сборка письма — секунды, отправка — до минуты
# на получателя (notifier.SMTP_TIMEOUT_SEC).
TimeoutStartSec=900

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/pharmacy-monitor/data /opt/pharmacy-monitor/logs
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
