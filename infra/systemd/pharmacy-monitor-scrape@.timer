[Unit]
Description=Daily scrape timer for %i

[Timer]
# Полный сбор — каждую ночь, все три сайта (src/cadence.py, решение владельца
# 2026-10-13). Будильников два. Первый собирает; три сайта стартуют вместе и
# идут по очереди под общим замком, вся очередь — около 70 минут. Второй —
# повтор для сайта, чей сбор не удался: собранный в этом окне сайт `run`
# пропускает без единого запроса, так что повтор ничего не стоит. Без повтора
# одна неудачная ночь любого сайта оставляла бы клиента без проверенных цен и
# без рекомендаций до следующей ночи. Не 02:xx: в ночь перевода часов этого
# часа либо нет, либо он дважды.
#
# Drop-in'ов у таймера в репозитории нет: недельный drop-in aptekonline снят
# 2026-10-13. На сервере его удаляет root — файл из /etc сам не исчезнет,
# docs/RUNBOOK.md «Ежедневный сбор: что стоит на сервере».
#
# Часы срабатывания связаны с границей окна CADENCE_ANCHOR_UTC: меняешь их —
# гони tests/test_cadence_guard.py.
OnCalendar=*-*-* 01:00:00
OnCalendar=*-*-* 03:15:00
RandomizedDelaySec=300
Persistent=true

[Install]
WantedBy=timers.target
