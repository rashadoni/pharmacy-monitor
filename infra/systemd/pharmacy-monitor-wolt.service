[Unit]
Description=Pharmacy Monitor — Wolt pharmacies catalog (separate comparison section)
Wants=network-online.target
After=network-online.target postgresql.service

[Service]
Type=oneshot
User=pm
Group=pm
WorkingDirectory=/opt/pharmacy-monitor
EnvironmentFile=/etc/pharmacy-monitor/env
# Аптеки на Wolt (src/wolt.py): свои таблицы wolt_items / wolt_scrapes, сбор
# через открытый API wolt.com, без прокси. Основной путь (сайты профиля,
# доверенные цены, письма, алерты) эти данные не читает. Около 300 запросов
# с паузой 0,7 с — несколько минут.
ExecStart=/opt/pharmacy-monitor/.venv/bin/pharmacy-monitor wolt sync
TimeoutStartSec=1800

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/pharmacy-monitor/data /opt/pharmacy-monitor/logs
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
