[Unit]
Description=Pharmacy Monitor — health check
After=network.target postgresql.service

[Service]
Type=oneshot
User=pm
Group=pm
WorkingDirectory=/opt/pharmacy-monitor
EnvironmentFile=/etc/pharmacy-monitor/env
ExecStart=/opt/pharmacy-monitor/.venv/bin/pharmacy-monitor health-check --quiet-on-ok

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/pharmacy-monitor/data /opt/pharmacy-monitor/logs
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
