[Unit]
Description=Electro Monitor — FastAPI backend (экземпляр электроники)
After=network.target postgresql.service redis.service
Requires=postgresql.service

[Service]
Type=simple
User=pm
Group=pm
WorkingDirectory=/opt/electro-monitor
# Профиль экземпляра (PM_PROFILE=electronics) и его база заданы только здесь:
# команда без этого файла окружения — аптечная, и база электроники ей откажет.
EnvironmentFile=/etc/electro-monitor/env
# Интерпретатор общий с аптечным экземпляром (зависимости одни), код — свой:
# `src` берётся из рабочего каталога.
ExecStart=/opt/pharmacy-monitor/.venv/bin/python -m uvicorn src.api:app \
    --host 127.0.0.1 \
    --port 8090 \
    --workers 2 \
    --proxy-headers \
    --forwarded-allow-ips '127.0.0.1'
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/electro-monitor/data /opt/electro-monitor/logs /opt/electro-monitor/reports
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
