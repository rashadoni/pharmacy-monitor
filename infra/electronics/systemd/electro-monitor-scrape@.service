[Unit]
Description=Electro Monitor — сбор сайта %i (irshad / bakuelectronics)
After=network.target postgresql.service
Requires=postgresql.service

[Service]
Type=oneshot
User=pm
Group=pm
WorkingDirectory=/opt/electro-monitor
EnvironmentFile=/etc/electro-monitor/env
# Ритм держит сам `run` (src/cadence.py): второй ночной запуск после удачного
# первого выходит с кодом 0 без сбора. Kontakt Home здесь не собирается — его
# каталог приходит файлом (`catalog import`).
ExecStart=/opt/pharmacy-monitor/.venv/bin/python -m src.main run --site %i
# Irshad просит паузу 30 секунд между запросами: полный каталог — часы.
TimeoutStartSec=36000

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/electro-monitor/data /opt/electro-monitor/logs /opt/electro-monitor/reports
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
