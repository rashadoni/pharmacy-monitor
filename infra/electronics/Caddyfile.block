
# --- Экземпляр электроники (infra/electronics/install.sh) ---
__DOMAIN__ {
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy strict-origin-when-cross-origin
        Permissions-Policy "geolocation=(), microphone=(), camera=()"
        -Server
    }

    @api path /api/* /docs /openapi.json /auth/* /health
    handle @api {
        reverse_proxy 127.0.0.1:__API_PORT__
    }
    handle {
        reverse_proxy 127.0.0.1:__WEB_PORT__
    }

    log {
        output stderr
        format filter {
            wrap console
            fields {
                request>uri regexp `(?i)([?&](?:[^=&]*(?:auth|cookie|token|secret|session|passw|pwd|signature|api[-_]?key)[^=&]*|key|code)=)[^&]*` ${1}<hidden>
                request>headers>Referer regexp `(?i)([?&](?:[^=&]*(?:auth|cookie|token|secret|session|passw|pwd|signature|api[-_]?key)[^=&]*|key|code)=)[^&]*` ${1}<hidden>
                resp_headers>Location regexp `(?i)([?&](?:[^=&]*(?:auth|cookie|token|secret|session|passw|pwd|signature|api[-_]?key)[^=&]*|key|code)=)[^&]*` ${1}<hidden>
                request>headers>Next-Router-State-Tree delete
                request>headers>X-Api-Key delete
            }
        }
        level INFO
    }
}
