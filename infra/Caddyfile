# Caddy reverse proxy for pharmacy-monitor.
#
# Auto-SSL via Let's Encrypt. DNS A record for leaddrive.cloud + www
# points to the production host.
#
# This is a sample, not the live file. /etc/caddy/Caddyfile is installed by
# root by hand and differs (2026-10-10: it also pins `servers { protocols h1 h2 }`),
# so do not copy this over it — diff first. `admin off` below means
# `systemctl reload caddy` fails: apply with `systemctl restart caddy`.

{
    # Global options
    email rashadrahimov@gmail.com  # for Let's Encrypt
    admin off                      # disable Caddy admin API on public iface
}

# === Production frontend (Next.js on :3000) + API (FastAPI on :8080) ===
leaddrive.cloud, www.leaddrive.cloud {
    # Security headers
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy strict-origin-when-cross-origin
        Permissions-Policy "geolocation=(), microphone=(), camera=()"
        # Remove server fingerprinting
        -Server
    }

    # API → FastAPI on 8080
    @api path /api/* /docs /openapi.json /auth/* /health /metrics
    handle @api {
        reverse_proxy 127.0.0.1:8080
    }

    # Grafana (observability) → :3001. Grafana serves under /grafana subpath
    # (GF_SERVER_SERVE_FROM_SUB_PATH=true, root_url=.../grafana/) + own login.
    # Install: см. docs/RUNBOOK.md «Observability (Prometheus + Grafana)».
    @grafana path /grafana /grafana/*
    handle @grafana {
        reverse_proxy 127.0.0.1:3001
    }

    # Everything else → Next.js on 3000
    handle {
        reverse_proxy 127.0.0.1:3000
    }

    # Logs (rotate via systemd-journald).
    #
    # The access log records the request URI, request headers and response
    # headers. Login links no longer carry their token in any of them (the
    # token sits after `#`), so this filter is a second layer: it blanks the
    # value of any query parameter whose name looks like a credential — in the
    # URI, in Referer and in a redirect's Location — and drops two headers:
    # Next-Router-State-Tree (Next.js copies the page address into it) and
    # X-Api-Key (Caddy redacts Cookie and Authorization by itself, not this).
    # Other parameters stay readable: `?search=…` is what the log is read for.
    # It is a list of names; a secret under a name not listed passes through.
    # Checked against real Caddy 2.6.2 and 2.10.2 by
    # tests/test_caddy_log_filter.py; installing it — docs/RUNBOOK.md.
    log {
        output stderr
        format filter {
            wrap console
            fields {
                request>uri regexp `(?i)([?&][^=&]*(?:token|secret|passw|pwd|key|code|session|signature|auth)[^=&]*=)[^&]*` ${1}<hidden>
                request>headers>Referer regexp `(?i)([?&][^=&]*(?:token|secret|passw|pwd|key|code|session|signature|auth)[^=&]*=)[^&]*` ${1}<hidden>
                resp_headers>Location regexp `(?i)([?&][^=&]*(?:token|secret|passw|pwd|key|code|session|signature|auth)[^=&]*=)[^&]*` ${1}<hidden>
                request>headers>Next-Router-State-Tree delete
                request>headers>X-Api-Key delete
            }
        }
        level INFO
    }
}

