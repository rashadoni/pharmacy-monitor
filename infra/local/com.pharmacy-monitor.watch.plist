<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  DEPRECATED 2026-07-03.
  UI scrape queue polling now runs on the server via
  pharmacy-monitor-scrape-watcher.timer. This plist should stay unloaded/disabled.
  The target script is fail-closed unless PHARMACY_MONITOR_ENABLE_MAC_SCRAPE=1 is
  explicitly set.

  Historical launchd config for polling scrape-requests from UI.
  Тикает раз в 60 секунд, опрашивает прод API, исполняет если есть pending.

  Установка:
    cp infra/local/com.pharmacy-monitor.watch.plist ~/Library/LaunchAgents/
    # API_KEY: один раз положить в Keychain
    security add-generic-password -a pm -s pharmacy-monitor-api-key -w '<API_KEY из /etc/pharmacy-monitor/env>'
    launchctl load -w ~/Library/LaunchAgents/com.pharmacy-monitor.watch.plist

  Снять:
    launchctl unload -w ~/Library/LaunchAgents/com.pharmacy-monitor.watch.plist

  Логи:
    tail -100 ~/Library/Logs/pharmacy-monitor-watch.log
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.pharmacy-monitor.watch</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/rashadrahimov/pharmacy-monitor/infra/local/watch-scrape-queue.sh</string>
    </array>

    <!-- Каждые 60 секунд -->
    <key>StartInterval</key>
    <integer>60</integer>

    <key>RunAtLoad</key>
    <false/>

    <!-- КРИТИЧНО: watcher спавнит detached-субшелл со скрейпом и сразу выходит.
         Без этого ключа launchd при выходе watcher-скрипта убивает всю
         process-group задачи — включая этот субшелл (& + disown НЕ спасает,
         см. man launchd.plist). Результат: скрейп никогда не стартует, запрос
         висит в 'running'. true = launchd НЕ трогает осиротевшие процессы. -->
    <key>AbandonProcessGroup</key>
    <true/>

    <key>WorkingDirectory</key>
    <string>/Users/rashadrahimov/pharmacy-monitor</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>HOME</key>
        <string>/Users/rashadrahimov</string>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/rashadrahimov/Library/Logs/pharmacy-monitor-watch-launchd.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/rashadrahimov/Library/Logs/pharmacy-monitor-watch-launchd.log</string>
</dict>
</plist>
</parameter>
