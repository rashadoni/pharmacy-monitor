<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  STALE since 2026-09-03.
  This tunnel fed the Postgres MCP on the owner's Mac and pointed at the Hetzner
  production host, which was deleted in 2026-09. Production now lives on Contabo
  (see CLAUDE.md). A copy of this agent that is still loaded keeps retrying the
  dead address every 30 seconds. Unload it:
    launchctl bootout gui/$UID/com.pharmacy-monitor.db-tunnel
    rm ~/Library/LaunchAgents/com.pharmacy-monitor.db-tunnel.plist

  The target below is a placeholder on purpose: the file must not connect
  anywhere until someone decides the tunnel is still wanted and points it at the
  current server with its host key pinned (infra/prod_known_hosts).
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.pharmacy-monitor.db-tunnel</string>

    <!-- SSH tunnel: Mac:5433 → prod:5432 for Postgres MCP -->
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/ssh</string>
        <string>-i</string>
        <string>/Users/rashadrahimov/.ssh/id_ed25519</string>
        <string>-N</string>
        <string>-T</string>
        <string>-L</string>
        <string>5433:localhost:5432</string>
        <!-- keep-alive: ping every 30s, drop after 3 missed -->
        <string>-o</string>
        <string>ServerAliveInterval=30</string>
        <string>-o</string>
        <string>ServerAliveCountMax=3</string>
        <!-- fail fast if port already used or auth fails -->
        <string>-o</string>
        <string>ExitOnForwardFailure=yes</string>
        <!-- non-interactive (no password prompts) -->
        <string>-o</string>
        <string>BatchMode=yes</string>
        <!-- never trust a host key on first use -->
        <string>-o</string>
        <string>StrictHostKeyChecking=yes</string>
        <string>root@prod-host-not-set.invalid</string>
    </array>

    <!-- Start when user logs in (or `launchctl load`) -->
    <key>RunAtLoad</key>
    <true/>

    <!-- Restart if process dies (network blip, server reboot, etc.) -->
    <key>KeepAlive</key>
    <true/>

    <!-- Wait 30s between restart attempts to avoid hammering -->
    <key>ThrottleInterval</key>
    <integer>30</integer>

    <!-- Logs -->
    <key>StandardOutPath</key>
    <string>/Users/rashadrahimov/Library/Logs/pharmacy-monitor-db-tunnel.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/rashadrahimov/Library/Logs/pharmacy-monitor-db-tunnel.log</string>

    <!-- Don't run if not logged in (avoids issues with screen-locked state) -->
    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
